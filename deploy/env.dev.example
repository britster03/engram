# Local Postgres development environment. Copy to .env.dev; do not commit it.
ENGRAM_API_KEY=change-me-dev-api-key
ENGRAM_ADMIN_KEY=change-me-dev-admin-key
NEO4J_ADMIN_PASSWORD=engram-dev-neo4j-password
OPENCODE_GO_API_KEY=change-me-opencode-go-key
ENGRAM_DB_PASSWORD=change-me-development-database-password
ENGRAM_DEV_DATABASE_URL=postgresql://engram_app:change-me-development-database-password@127.0.0.1:5433/engram
# API, worker and dispatcher must load the same configuration and environment.
ENGRAM_CONFIG_PATH=./config.dev.postgres.yaml
ENGRAM_ENV_FILE=.env.dev

# Token-only compaction; restart API/workers after changing these values.
ENGRAM_SESSION_COMPACTION_TRIGGER_TOKENS=64000
ENGRAM_SESSION_COMPACTION_TARGET_RATIO=0.5
ENGRAM_SESSION_COMPACTION_INPUT_TOKENS=64000
ENGRAM_SESSION_COMPACTION_SUMMARY_TOKENS=2000
ENGRAM_RETRIEVAL_QUALITY_MODE=enforce
